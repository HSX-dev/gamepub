# 本地开发环境变量清单（不含值）。用 `make keys` 生成真实的 .env，切勿提交 .env。
# 生产环境这些值由 External Secrets 从 Vault 同步到各服务独立的 K8s Secret。

# account：令牌签名私钥（Ed25519 seed，base64）、手机号加密密钥（32 字节，base64）、盲索引 pepper
JWT_ED25519_SEED=
PII_AES_KEY=
PHONE_PEPPER=

# gateway：只持有公钥
JWT_ED25519_PUBLIC=

# 所有服务：服务间调用凭据（≥32 字符）、Redis 口令（≥16 字符）
INTERNAL_TOKEN=
REDIS_PASSWORD=

# order：支付渠道验签密钥、发货回调签名密钥
PAY_MOCKPAY_SECRET=
DELIVERY_SIGN_SECRET=

# MySQL（本地 compose 用于创建各服务独立账号）
MYSQL_ROOT_PASSWORD=
ACCOUNT_DB_PASSWORD=
WALLET_DB_PASSWORD=
ORDER_DB_PASSWORD=
TASK_DB_PASSWORD=
